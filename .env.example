NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
WEB_URL=http://localhost:3000
# URL pública da API, acessível pelos sites rastreados. Se vazia, a API usa
# automaticamente o protocolo e host da requisição recebida.
API_PUBLIC_URL=
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
NUXT_PUBLIC_TRACKER_BASE=http://localhost:4000
MONGODB_URI=mongodb://user:password@mongo.example.com:27017/akros-pulse?authSource=admin
REDIS_URL=rediss://default:password@redis.example.com:6380
TRUST_PROXY=false
COLLECTOR_ALLOW_ANY_ORIGIN=false
IP_RETENTION_DAYS=90
REPLAY_RETENTION_DAYS=30
CACHE_TTL_SECONDS=90
