{
  "name": "@akros/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:tracker && tsx watch src/server.ts",
    "build:tracker": "esbuild src/tracker-client.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/public/tracker.js",
    "build": "tsc -p tsconfig.json && npm run build:tracker",
    "start": "node dist/server.js",
    "test": "npm run build:tracker && node --import tsx --test src/**/*.test.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "isbot": "^5.1.30",
    "jose": "^6.2.4",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.1",
    "nanoid": "^5.1.6",
    "otplib": "^13.4.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/geoip-lite": "^1.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
